<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:BarengIn.Desktop.Models"
        xmlns:s="using:BarengIn.Infrastructure.Services"
        x:Class="BarengIn.Desktop.Views.DriverWindow"
        Title="BarengIn - Driver"
        Width="960" Height="650"
        MinWidth="840" MinHeight="560"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="20" RowDefinitions="Auto,16,*,12,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="lblWelcome" Classes="heading" VerticalAlignment="Center" />
            <Button x:Name="btnProfile" Grid.Column="1" Classes="secondary" Content="Profile"
                    Width="90" Click="btnProfile_Click" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="380,24,*">
            <Grid Grid.Column="0" RowDefinitions="Auto,8,Auto,10,Auto,8,Auto,10,*">
                <TextBlock Grid.Row="0" Classes="section" Text="Post a trip" />
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,4,Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                    <TextBlock Grid.Row="0" Classes="label" Text="Pickup area :" Margin="0,0,14,0" />
                    <TextBox x:Name="tbOrigin" Grid.Row="0" Grid.Column="1"
                             PlaceholderText="Type area (e.g. pogu, jakal, seturan)..."
                             TextChanged="tbOrigin_TextChanged" />

                    <Border x:Name="bdrSuggestions" Grid.Row="2" Grid.Column="1"
                            Background="White" BorderBrush="#228B5E" BorderThickness="1"
                            CornerRadius="6" Padding="2" MaxHeight="155" IsVisible="False">
                        <ListBox x:Name="lvSuggestions" Background="White"
                                 SelectionChanged="lvSuggestions_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="s:PlaceSuggestion">
                                    <StackPanel Spacing="1" Margin="2,2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Grid.Row="4" Classes="label" Text="Destination :" Margin="0,0,14,0" />
                    <ComboBox x:Name="cbFaculty" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="6" Classes="label" Text="Departs :" Margin="0,0,14,0" />
                    <TimePicker x:Name="dtpTime" Grid.Row="6" Grid.Column="1" ClockIdentifier="24HourClock"
                                SelectedTime="07:30:00" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="8" Classes="label" Text="Seats :" Margin="0,0,14,0" />
                    <NumericUpDown x:Name="nudSeats" Grid.Row="8" Grid.Column="1" Minimum="1" Maximum="6"
                                   Value="3" FormatString="0" HorizontalAlignment="Left" Width="140" />

                    <TextBlock Grid.Row="10" Classes="label" Text="Cost / seat :" Margin="0,0,14,0" />
                    <NumericUpDown x:Name="nudCost" Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="100000"
                                   Increment="1000" Value="5000" FormatString="N0" HorizontalAlignment="Left"
                                   Width="140" />
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="*,10,Auto">
                    <Button x:Name="btnPost" Grid.Column="0" Classes="primary" Content="Post Trip"
                            HorizontalAlignment="Stretch" Height="40" Click="btnPost_Click" />
                    <Button x:Name="btnCheckRoute" Grid.Column="2" Classes="secondary" Content="Check Route"
                            Width="116" Height="40" Click="btnCheckRoute_Click" />
                </Grid>

                <Border Grid.Row="6" Background="#F7FAF8" BorderBrush="#D7E6DD" BorderThickness="1"
                        CornerRadius="4" Padding="10,6">
                    <TextBlock x:Name="lblRouteInfo" Classes="muted" TextWrapping="Wrap" FontSize="12"
                               Text="Enter a pickup area and click Check Route or Post Trip to preview route distance and ETA." />
                </Border>

                <Grid Grid.Row="8" RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="section" Text="Your posted trips" Margin="0,2,0,4" />
                    <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" MinHeight="110">
                      <Grid RowDefinitions="Auto,*">
                        <Grid Background="#F3F3F3" ColumnDefinitions="*,56,40,*" Height="26">
                            <TextBlock Grid.Column="0" Text="Pickup" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBlock Grid.Column="1" Text="Departs" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Seats" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Cost" FontWeight="SemiBold" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,12,0" />
                        </Grid>
                        <ListBox x:Name="lvTrips" Grid.Row="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="m:TripRow">
                                    <Grid ColumnDefinitions="*,56,40,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Pickup}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Departs}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Seats}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Cost}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Classes="section" Text="Ride requests" VerticalAlignment="Center" />
                    <Button x:Name="btnRefresh" Grid.Column="1" Classes="secondary" Content="Refresh"
                            Width="90" Click="btnRefresh_Click" />
                </Grid>
                <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1">
                    <ListBox x:Name="lvRequests">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:RequestItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Passenger}" FontWeight="SemiBold" />
                                        <TextBlock Classes="muted" FontSize="12">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}  ·  {1}">
                                                    <Binding Path="Pickup" />
                                                    <Binding Path="Faculty" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ProfileSummary}"
                                                   IsVisible="{Binding HasProfileSummary}"
                                                   Foreground="#228B5E" FontSize="11.5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsPending}">
                                        <Button Classes="primary" Content="Approve" Width="84"
                                                Click="btnApprove_Click" />
                                        <Button Classes="secondary" Content="Reject" Width="84"
                                                Click="btnReject_Click" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="#555555"
                                               IsVisible="{Binding !IsPending}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <Button x:Name="btnLogout" Grid.Row="4" Classes="secondary" Content="Logout" Width="100"
                Height="40" HorizontalAlignment="Right" Click="btnLogout_Click" />
    </Grid>
</Window>
