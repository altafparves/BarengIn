<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:BarengIn.Desktop.Models"
        xmlns:s="using:BarengIn.Infrastructure.Services"
        x:Class="BarengIn.Desktop.Views.HomeWindow"
        Title="BarengIn - Find a Ride"
        Width="740" Height="580"
        MinWidth="560" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="20" RowDefinitions="Auto,16,Auto,10,Auto,12,*,12,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="lblWelcome" Classes="heading" VerticalAlignment="Center" />
            <Button x:Name="btnProfile" Grid.Column="1" Classes="secondary" Content="Profile"
                    Width="90" Click="btnProfile_Click" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,16,170" RowDefinitions="Auto,4,Auto,8,Auto,8,Auto">
            <TextBlock Grid.Row="0" Classes="label" Text="Pickup area :" Margin="0,0,16,0" />
            <TextBox x:Name="tbOrigin" Grid.Row="0" Grid.Column="1"
                     PlaceholderText="Type area (e.g. pogu, jakal, seturan)..."
                     TextChanged="tbOrigin_TextChanged" />

            <Border x:Name="bdrSuggestions" Grid.Row="2" Grid.Column="1"
                    Background="White" BorderBrush="#228B5E" BorderThickness="1"
                    CornerRadius="6" Padding="2" MaxHeight="165" IsVisible="False">
                <ListBox x:Name="lvSuggestions" Background="White"
                         SelectionChanged="lvSuggestions_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="s:PlaceSuggestion">
                            <StackPanel Spacing="1" Margin="2,2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Grid.Row="4" Classes="label" Text="Destination :" Margin="0,0,16,0" />
            <ComboBox x:Name="cbFaculty" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="6" Classes="label" Text="Class starts :" Margin="0,0,16,0" />
            <TimePicker x:Name="dtpTime" Grid.Row="6" Grid.Column="1" ClockIdentifier="24HourClock"
                        SelectedTime="08:00:00" HorizontalAlignment="Left" />

            <Button x:Name="btnFind" Grid.Row="0" Grid.RowSpan="7" Grid.Column="3" Classes="primary"
                    Content="Find Rides" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Height="45" Click="btnFind_Click" />
        </Grid>

        <Border Grid.Row="4" Background="#F7FAF8" BorderBrush="#D7E6DD" BorderThickness="1"
                CornerRadius="4" Padding="10,6">
            <TextBlock x:Name="lblRouteInfo" Classes="muted" TextWrapping="Wrap" FontSize="12"
                       Text="Enter your pickup area and click Find Rides to preview route distance, ETA, and CO2 saved." />
        </Border>

        <Border Grid.Row="6" BorderBrush="#D0D0D0" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Grid Background="#F3F3F3" Margin="0" ColumnDefinitions="110,120,130,68,52,*" Height="30">
                    <TextBlock Grid.Column="0" Text="Driver" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Grid.Column="1" Text="Pickup" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Faculty" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Departs" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Seats" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="Cost" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
                <ListBox x:Name="lvRides" Grid.Row="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:RideRow">
                            <StackPanel Spacing="2" Margin="0,2">
                                <Grid ColumnDefinitions="98,120,130,68,52,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Driver}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Pickup}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Faculty}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Departs}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Seats}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Cost}" />
                                </Grid>
                                <TextBlock Text="{Binding DriverProfileSummary}"
                                           IsVisible="{Binding HasDriverProfile}"
                                           Foreground="#228B5E" FontSize="11.5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="8" ColumnDefinitions="150,16,*,Auto">
            <Button x:Name="btnRequest" Grid.Column="0" Classes="primary" Content="Request Ride"
                    HorizontalAlignment="Stretch" Height="40" Click="btnRequest_Click" />
            <TextBlock x:Name="lblCo2" Grid.Column="2" Classes="label" />
            <Button x:Name="btnLogout" Grid.Column="3" Classes="secondary" Content="Logout"
                    Width="100" Height="40" Click="btnLogout_Click" />
        </Grid>
    </Grid>
</Window>
