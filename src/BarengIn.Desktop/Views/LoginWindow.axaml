<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BarengIn.Desktop.Views.LoginWindow"
        Title="BarengIn - Login"
        Width="390" Height="490"
        MinWidth="340" MinHeight="430"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#F4F8F6">

    <Border Classes="card" Margin="20" VerticalAlignment="Center">
        <StackPanel Spacing="7">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,2">
                <Border Width="38" Height="38" CornerRadius="10" Background="#228B5E">
                    <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="title" Text="BarengIn" FontSize="26" />
                </StackPanel>
                <Border Classes="pill" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="UGM Eco-Carpool" FontSize="11" FontWeight="SemiBold" Foreground="#14573B" />
                </Border>
            </StackPanel>

            <TextBlock Classes="muted" Text="Carpool to campus, matched by your class schedule &amp; faculty."
                       TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,8" />

            <TextBlock Classes="label" Text="I am a :" />
            <ComboBox x:Name="cbRole" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem>Passenger</ComboBoxItem>
                <ComboBoxItem>Driver</ComboBoxItem>
                <ComboBoxItem>Admin</ComboBoxItem>
            </ComboBox>

            <TextBlock Classes="label" Text="Student ID (NIM) or Email :" Margin="0,6,0,0" />
            <TextBox x:Name="tbUsername" PlaceholderText="e.g. 24/500001/TK/50001 or student@mail.ugm.ac.id" />

            <TextBlock Classes="label" Text="Password :" Margin="0,6,0,0" />
            <TextBox x:Name="tbPassword" PasswordChar="•" PlaceholderText="Enter your password" />

            <Grid ColumnDefinitions="*,12,*" Margin="0,14,0,0">
                <Button x:Name="btnLogin" Grid.Column="0" Classes="primary" Content="Login"
                        HorizontalAlignment="Stretch" Height="40" Click="btnLogin_Click" />
                <Button x:Name="btnClose" Grid.Column="2" Classes="secondary" Content="Close"
                        HorizontalAlignment="Stretch" Height="40" Click="btnClose_Click" />
            </Grid>

            <Button x:Name="btnRegister" Classes="link" Content="No account yet? Create one"
                    HorizontalAlignment="Center" Margin="0,4,0,0" Click="btnRegister_Click" />
        </StackPanel>
    </Border>
</Window>
