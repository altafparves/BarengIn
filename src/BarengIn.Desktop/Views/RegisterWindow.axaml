<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BarengIn.Desktop.Views.RegisterWindow"
        Title="BarengIn - Create Account"
        Width="440" Height="740"
        MinWidth="380" MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#F4F8F6">

    <ScrollViewer>
        <Border Classes="card" Margin="20">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="heading" Text="Create your account" VerticalAlignment="Center" />
                    <Border Classes="pill" VerticalAlignment="Center">
                        <TextBlock Text="KTM Verified" FontSize="11" FontWeight="SemiBold" Foreground="#14573B" />
                    </Border>
                </StackPanel>
                <TextBlock Classes="muted" Text="Every student is verified with their UGM student ID card (KTM)."
                           TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,6" />

                <TextBlock Classes="label" Text="I am registering as :" />
                <ComboBox x:Name="cbRole" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem>Passenger</ComboBoxItem>
                    <ComboBoxItem>Driver</ComboBoxItem>
                </ComboBox>

                <TextBlock Classes="label" Text="Full name :" Margin="0,4,0,0" />
                <TextBox x:Name="tbName" PlaceholderText="e.g. Budi Santoso" />

                <TextBlock Classes="label" Text="Student ID (NIM) :" Margin="0,4,0,0" />
                <TextBox x:Name="tbNim" PlaceholderText="e.g. 24/500001/TK/50001" />

                <TextBlock Classes="label" Text="Email :" Margin="0,4,0,0" />
                <TextBox x:Name="tbEmail" PlaceholderText="e.g. student@mail.ugm.ac.id" />

                <TextBlock Classes="label" Text="Phone number :" Margin="0,4,0,0" />
                <TextBox x:Name="tbPhone" PlaceholderText="e.g. 081234567890" />

                <TextBlock Classes="label" Text="Faculty :" Margin="0,4,0,0" />
                <ComboBox x:Name="cbFaculty" HorizontalAlignment="Stretch" SelectedIndex="0" />

                <TextBlock Classes="label" Text="Password :" Margin="0,4,0,0" />
                <TextBox x:Name="tbPassword" PasswordChar="•" />

                <TextBlock Classes="label" Text="Confirm password :" Margin="0,4,0,0" />
                <TextBox x:Name="tbConfirm" PasswordChar="•" />

                <TextBlock Classes="label" Text="KTM photo :" Margin="0,4,0,0" />
                <Border Background="#F7FAF8" BorderBrush="#D7E6DD" BorderThickness="1" CornerRadius="6" Padding="10,8">
                    <Grid ColumnDefinitions="Auto,12,*">
                        <Button x:Name="btnKtm" Grid.Column="0" Classes="secondary" Content="Choose file..."
                                Click="btnKtm_Click" />
                        <TextBlock x:Name="lblKtm" Grid.Column="2" Classes="muted label" Text="No file selected"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,12,*" Margin="0,12,0,0">
                    <Button x:Name="btnRegister" Grid.Column="0" Classes="primary" Content="Register"
                            HorizontalAlignment="Stretch" Height="40" Click="btnRegister_Click" />
                    <Button x:Name="btnBack" Grid.Column="2" Classes="secondary" Content="Back"
                            HorizontalAlignment="Stretch" Height="40" Click="btnBack_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
