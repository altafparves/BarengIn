<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BarengIn.Desktop.Views.RegisterWindow"
        Title="BarengIn - Create Account"
        Width="420" Height="740"
        MinWidth="380" MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="6">
            <TextBlock Classes="heading" Text="Create your account" />
            <TextBlock Classes="muted" Text="Every user is verified with their student ID card (KTM)."
                       TextWrapping="Wrap" Margin="0,0,0,6" />

            <TextBlock Text="I am registering as :" />
            <ComboBox x:Name="cbRole" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem>Passenger</ComboBoxItem>
                <ComboBoxItem>Driver</ComboBoxItem>
            </ComboBox>

            <TextBlock Text="Full name :" Margin="0,4,0,0" />
            <TextBox x:Name="tbName" PlaceholderText="e.g. Altaf Parves" />

            <TextBlock Text="Student ID (NIM) :" Margin="0,4,0,0" />
            <TextBox x:Name="tbNim" PlaceholderText="e.g. 24/536741/TK/59565" />

            <TextBlock Text="Email :" Margin="0,4,0,0" />
            <TextBox x:Name="tbEmail" PlaceholderText="e.g. altaf@mail.ugm.ac.id" />

            <TextBlock Text="Phone number :" Margin="0,4,0,0" />
            <TextBox x:Name="tbPhone" PlaceholderText="e.g. 081234567890" />

            <TextBlock Text="Faculty :" Margin="0,4,0,0" />
            <ComboBox x:Name="cbFaculty" HorizontalAlignment="Stretch" SelectedIndex="0" />

            <TextBlock Text="Password :" Margin="0,4,0,0" />
            <TextBox x:Name="tbPassword" PasswordChar="•" />

            <TextBlock Text="Confirm password :" Margin="0,4,0,0" />
            <TextBox x:Name="tbConfirm" PasswordChar="•" />

            <TextBlock Text="KTM photo :" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="Auto,12,*">
                <Button x:Name="btnKtm" Grid.Column="0" Classes="secondary" Content="Choose file..."
                        Click="btnKtm_Click" />
                <TextBlock x:Name="lblKtm" Grid.Column="2" Classes="muted label" Text="No file selected"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid ColumnDefinitions="*,12,*" Margin="0,14,0,0">
                <Button x:Name="btnRegister" Grid.Column="0" Classes="primary" Content="Register"
                        HorizontalAlignment="Stretch" Height="40" Click="btnRegister_Click" />
                <Button x:Name="btnBack" Grid.Column="2" Classes="secondary" Content="Back"
                        HorizontalAlignment="Stretch" Height="40" Click="btnBack_Click" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
