# EditorConfig for BarengIn - shared by the backend and the frontend.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C# - 4 spaces
[*.cs]
indent_style = space
indent_size = 4

# Web and config files - 2 spaces
[*.{js,ts,jsx,tsx,json,yml,yaml,html,css}]
indent_style = space
indent_size = 2

# Razor / Blazor components, if that is the frontend we end up with
[*.{razor,cshtml}]
indent_style = space
indent_size = 4

# Project and solution files
[*.{csproj,props,targets}]
indent_style = space
indent_size = 2

# Markdown - trailing whitespace can be a deliberate line break
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
